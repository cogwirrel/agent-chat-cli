{
  "name": "@agent-chat-cli/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "prepare": "husky || true",
    "build": "nx run-many --target build",
    "lint": "nx run-many --target lint --configuration=fix",
    "build:skip-lint": "nx run-many --target build --configuration=skip-lint",
    "build:all": "nx run-many --target build --all",
    "affected:all": "nx affected --target build"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "private": true,
  "dependencies": {
    "@a2a-js/sdk": "^0.3.13",
    "@ag-ui/client": "^0.0.53",
    "@aws/nx-plugin": "0.108.0",
    "@clack/prompts": "^1.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.8.0",
    "@nx/eslint": "22.7.1",
    "@nx/eslint-plugin": "22.7.1",
    "@nx/js": "22.7.1",
    "@nx/vitest": "22.7.1",
    "@nx/workspace": "22.7.1",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/node": "20.19.9",
    "@vitest/coverage-v8": "4.1.5",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "5.5.5",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "3.1.0",
    "lint-staged": "^16.4.0",
    "nx": "22.7.1",
    "prettier": "3.8.3",
    "tslib": "^2.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.1",
    "vite": "8.0.8",
    "vitest": "4.1.5"
  },
  "type": "module"
}
